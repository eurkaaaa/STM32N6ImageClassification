typedef struct
{
  uint32_t exc_return;
  uint32_t stacked_r0;
  uint32_t stacked_r1;
  uint32_t stacked_r2;
  uint32_t stacked_r3;
  uint32_t stacked_r12;
  uint32_t stacked_lr;
  uint32_t stacked_pc;
  uint32_t stacked_xpsr;
  uint32_t cfsr;
  uint32_t hfsr;
  uint32_t dfsr;
  uint32_t afsr;
  uint32_t mmfar;
  uint32_t bfar;
  uint32_t shcsr;
  uint32_t control;
  uint32_t ipsr;
} FaultDiag_t;

static volatile FaultDiag_t g_fault_diag;

static inline uint32_t FaultDiag_GetIPSR(void)
{
  uint32_t ipsr;
  __asm volatile("mrs %0, ipsr" : "=r"(ipsr));
  return ipsr;
}

static inline int FaultDiag_DebugAttached(void)
{
  return ((CoreDebug->DHCSR & CoreDebug_DHCSR_C_DEBUGEN_Msk) != 0U);
}

static void FaultDiag_Capture(uint32_t *stacked_regs, uint32_t exc_return)
{
  g_fault_diag.exc_return   = exc_return;
  g_fault_diag.stacked_r0   = stacked_regs[0];
  g_fault_diag.stacked_r1   = stacked_regs[1];
  g_fault_diag.stacked_r2   = stacked_regs[2];
  g_fault_diag.stacked_r3   = stacked_regs[3];
  g_fault_diag.stacked_r12  = stacked_regs[4];
  g_fault_diag.stacked_lr   = stacked_regs[5];
  g_fault_diag.stacked_pc   = stacked_regs[6];
  g_fault_diag.stacked_xpsr = stacked_regs[7];

  g_fault_diag.cfsr   = SCB->CFSR;
  g_fault_diag.hfsr   = SCB->HFSR;
  g_fault_diag.dfsr   = SCB->DFSR;
  g_fault_diag.afsr   = SCB->AFSR;
  g_fault_diag.mmfar  = SCB->MMFAR;
  g_fault_diag.bfar   = SCB->BFAR;
  g_fault_diag.shcsr  = SCB->SHCSR;
  g_fault_diag.control = __get_CONTROL();
  g_fault_diag.ipsr   = FaultDiag_GetIPSR();

  if (FaultDiag_DebugAttached())
  {
    __BKPT(0);
  }
}

static void HardFault_Handler_C(uint32_t *stacked_regs, uint32_t exc_return)
{
  FaultDiag_Capture(stacked_regs, exc_return);
  while (1)
